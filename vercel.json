{
  "version": 2,
  "framework": null,
  "buildCommand": "python3 packaging/build_web.py",
  "outputDirectory": "build/web",
  "redirects": [
    {"source": "/", "destination": "/play", "permanent": false},
    {"source": "/play/", "destination": "/play", "permanent": false}
  ],
  "rewrites": [
    {"source": "/play", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/play",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/index.service.worker.js",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/favicon.:ext",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/planet-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
