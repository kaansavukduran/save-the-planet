config_version=5

[application]
config/name="Save the Planet"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]
State="*res://scripts/state.gd"
Controls="*res://scripts/controls.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07,0.15,0.19,1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
